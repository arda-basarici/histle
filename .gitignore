data/raw/
data/cache/

# Python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / frontend tooling (if it ever appears)
node_modules/

# OS noise
Thumbs.db
.DS_Store

